{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "python3 montar.py --dominio \"https://${VERCEL_PROJECT_PRODUCTION_URL:-casa-do-marceneiro-tatuape.vercel.app}/\" --forcar",
  "outputDirectory": "publicar",
  "trailingSlash": true,
  "redirects": [
    { "source": "/portfolio", "destination": "/projetos/", "permanent": true },
    { "source": "/portfolio/:resto*", "destination": "/projetos/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/fotos/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }]
    }
  ]
}
